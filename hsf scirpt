-- Update character visualization and prediction
RunService.RenderStepped:Connect(function()
    local root = getRoot(player.Character)

    sphere.Size = Vector3.one * (settings.catchRadius * 2)
    sphere.Transparency = settings.visualize and 0.82 or 1

    if root then
        sphere.Position = root.Position
    else
        sphere.Transparency = 1
    end

    -- Calculate the predicted target for your own passing UI.
    if settings.mode == "QB" and root and settings.receiver then
        local target = getLeadPosition(settings.receiver, root.Position)
        -- Connect target to your own game's reticle or throwing system.
    end
end)

-- Keyboard shortcuts
UIS.InputBegan:Connect(function(input, processed)
    if processed then return end

    if input.KeyCode == Enum.KeyCode.B then
        settings.mode = settings.mode == "QB" and "WR" or "QB"
        status.Text = "Mode: " .. settings.mode
    elseif input.KeyCode == Enum.KeyCode.N then
        settings.receiver = findNearestReceiver()
        status.Text = settings.receiver
            and ("Receiver: " .. settings.receiver.Name)
            or "No receiver found"
    elseif input.KeyCode == Enum.KeyCode.RightShift then
        main.Visible = not main.Visible
    end
end)

-- Drag menu using title bar
local dragging, dragStart, startPos = false, nil, nil

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

close.Activated:Connect(function()
    main.Visible = false
end)

player.CharacterAdded:Connect(function(character)
    local hum = character:WaitForChild("Humanoid")
    hum.UseJumpPower = true
    hum.JumpPower = settings.jumpPower
    hum.WalkSpeed = settings.walkSpeed
end)

