-- Player helpers
local function getRoot(character)
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function findNearestReceiver()
    local myRoot = getRoot(player.Character)
    if not myRoot then return nil end

    local nearest, bestDistance = nil, math.huge

    for _, other in Players:GetPlayers() do
        if other ~= player then
            local root = getRoot(other.Character)
            if root then
                local distance = (root.Position - myRoot.Position).Magnitude
                if distance < bestDistance then
                    nearest = other
                    bestDistance = distance
                end
            end
        end
    end

    return nearest
end

local function getLeadPosition(receiver, origin)
    local root = receiver and getRoot(receiver.Character)
    if not root then return nil end

    local distance = (root.Position - origin).Magnitude
    local timeToTarget = distance / math.max(settings.throwSpeed, 1)

    return root.Position
        + root.AssemblyLinearVelocity
        * timeToTarget
        * settings.leadMultiplier
end

